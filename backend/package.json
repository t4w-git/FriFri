{
  "name": "frifri-backend",
  "version": "1.0.0",
  "description": "Enterprise-level backend for Frifri game platform",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --import tsx src/server.ts",
    "build": "tsc && node scripts/copy-templates.mjs",
    "build:full": "npm install && npm --prefix ../frontend install && npm --prefix ../frontend run build && npm run build",
    "start": "NODE_ENV=production node dist/server.js",
    "postinstall": "prisma generate",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx src/db/migrate.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "node --import tsx src/db/seed.ts",
    "seed:db": "node --import tsx src/db/seed.ts",
    "db:reset": "node --import tsx src/db/reset.ts"
  },
  "keywords": [
    "poetry",
    "games",
    "sponsors",
    "prizes"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.43.0",
    "axios": "^1.6.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.2",
    "pino": "^8.17.2",
    "pino-http": "^8.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "prisma": "^5.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.23",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.56.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  }
}
